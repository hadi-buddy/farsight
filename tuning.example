# Farsight tuning. Copy to ~/tools/farsight/tuning, edit, then relaunch (./launch.sh).
# No rebuild needed. Lines starting with # are ignored; delete a line to use the default.

# Speech probability that starts a phrase. Lower = picks up quiet speech, but also noise.
vad_threshold = 0.5

# Pause (seconds) that ends a phrase. Higher = fewer words split in two, but text appears later.
min_silence = 0.9

# Shortest phrase (s) and longest phrase (s) before a forced break.
min_speech = 0.25
max_speech = 15

# Extra audio (s) given to the model before / after each phrase, so first and last
# syllables are not clipped.
preroll = 0.35
postroll = 0.15

# CPU threads for the speech model.
threads = 2

# 1 = save every phrase as a WAV file plus its text in ~/Library/Logs/farsight/audio/
# (index.tsv), to compare what was said with what was written.
dump = 0
